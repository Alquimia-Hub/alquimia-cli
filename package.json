{
  "name": "alquimia-cli",
  "version": "0.6.0",
  "description": "CLI de la comunidad Alquimia — IA, automatización y productividad (TUI con OpenTUI)",
  "bin": {
    "alquimia": "bin/alquimia.js"
  },
  "type": "module",
  "files": [
    "bin",
    "src",
    "scripts",
    "assets",
    "completions",
    "tsconfig.json"
  ],
  "scripts": {
    "start": "bun bin/alquimia.ts",
    "info": "bun bin/alquimia.ts info",
    "dino": "bun bin/alquimia.ts dino",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "keywords": [
    "alquimia",
    "cli",
    "tui",
    "opentui",
    "bun",
    "comunidad",
    "ia",
    "automatizacion"
  ],
  "author": "Alquimia Hub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alquimia-Hub/alquimia-cli.git"
  },
  "homepage": "https://alquimia.community/",
  "bugs": {
    "url": "https://github.com/Alquimia-Hub/alquimia-cli/issues"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1"
  },
  "optionalDependencies": {
    "bun": "^1.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
